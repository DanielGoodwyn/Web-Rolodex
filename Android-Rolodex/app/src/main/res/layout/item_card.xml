<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card Header (Always Visible) -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/imgChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Expand/Collapse"
                android:src="@android:drawable/arrow_down_float"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvCardNumber"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="01" />

            <TextView
                android:id="@+id/tvCardName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Philz Coffee - Castro" />

            <!-- Rating Chip/Badge -->
            <TextView
                android:id="@+id/tvRatingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rating_badge"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/badge_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="95" />

            <!-- Edit Button -->
            <ImageButton
                android:id="@+id/btnEditCard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit Card"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/text_secondary" />

            <!-- Delete Button -->
            <ImageButton
                android:id="@+id/btnDeleteCard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete Card"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/delete_red" />
        </LinearLayout>

        <!-- Expandable Body Content -->
        <LinearLayout
            android:id="@+id/expandableBodyLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider" />

            <!-- Types Chips Section -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCardTypes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <!-- Location & Google Maps Navigation Section -->
            <LinearLayout
                android:id="@+id/locationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="548 Castro St, San Francisco, CA 94114" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Native Google Maps Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogleMaps"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="@color/google_maps_bg"
                        android:text="@string/open_google_maps"
                        android:textColor="@color/google_maps"
                        android:textSize="12sp"
                        app:cornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/google_maps"
                        app:icon="@android:drawable/ic_dialog_map"
                        app:iconTint="@color/google_maps" />

                    <TextView
                        android:id="@+id/tvNeighborhoodAndDistance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="Castro • 0.8 mi" />
                </LinearLayout>
            </LinearLayout>

            <!-- Links (Web, FB, Insta, X) Section -->
            <LinearLayout
                android:id="@+id/linksSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <!-- Links Section Title -->
                <TextView
                    android:id="@+id/tvLinksTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Links"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />

                <!-- Action Buttons (Web, FB, Insta, X) -->
                <HorizontalScrollView
                    android:id="@+id/linksButtonsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/linksContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWeb"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:text="🌐 Web"
                            android:textColor="@color/primary"
                            app:cornerRadius="8dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/primary"
                            android:textSize="11sp"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFacebook"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:text="👥 FB"
                            android:textColor="@color/facebook_blue"
                            app:cornerRadius="8dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/facebook_blue"
                            android:textSize="11sp"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnInstagram"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:text="📷 Insta"
                            android:textColor="@color/instagram_gradient"
                            app:cornerRadius="8dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/instagram_gradient"
                            android:textSize="11sp"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnX"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="✕ X"
                            android:textColor="@color/x_black"
                            app:cornerRadius="8dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/x_black"
                            android:textSize="11sp"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- URL Inputs (www, fb, insta, x) matching Web -->
                <LinearLayout
                    android:id="@+id/layoutLinkInputsRow1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etLinkWeb"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_link_input"
                        android:hint="www (url)"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="11sp"
                        android:paddingHorizontal="8dp"
                        android:inputType="textUri"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />

                    <EditText
                        android:id="@+id/etLinkFb"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_link_input"
                        android:hint="fb (url)"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="11sp"
                        android:paddingHorizontal="8dp"
                        android:inputType="textUri"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutLinkInputsRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etLinkIg"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_link_input"
                        android:hint="insta (url)"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="11sp"
                        android:paddingHorizontal="8dp"
                        android:inputType="textUri"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />

                    <EditText
                        android:id="@+id/etLinkX"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_link_input"
                        android:hint="x (url)"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="11sp"
                        android:paddingHorizontal="8dp"
                        android:inputType="textUri"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:background="@color/divider" />

            <!-- Associates / Associated With Section -->
            <TextView
                android:id="@+id/tvAssociatesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/associates_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Chips container for linked associates/parents -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAssociates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- Add Associate Input with Autocomplete -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/add_associate_hint">

                    <AutoCompleteTextView
                        android:id="@+id/etNewAssociate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPersonName|textCapWords"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddAssociate"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:background="@color/divider" />

            <!-- Notes Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notes_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Notes RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_note" />

            <!-- Add Note Inputs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="New Note">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNewNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddNote"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
